{
  "name": "alltvcnl",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "electron-main.js",
  "author": "Arif Miah 07",
  "description": "Fast, secure IPTV player for web and desktop",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:electron && node scripts/generate-sitemap.mjs",
    "build:web": "vite build && node scripts/generate-sitemap.mjs",
    "build:electron": "vite build --mode electron",
    "preview": "vite preview --outDir dist-web",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron-build": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:win-portable": "npm run build:electron && electron-builder --win portable",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "dist:linux": "npm run build:electron && electron-builder --linux"
  },
  "build": {
    "appId": "com.arifmiah.iptv-player",
    "productName": "IPTV-Player",
    "icon": "public/favicon.png",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.0",
    "hls.js": "^1.6.6",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^24.10.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.20.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.0.4"
  }
}
